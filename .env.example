# 复制成 .env 并填入你的百炼 API Key（只存在本机，不进 git）
DASHSCOPE_API_KEY=sk-你的key填这里

# 以下都有默认值，不想改可以整段删掉
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longjielidou_v3.6
# 英文课的音色。留空 = 跟 TTS_VOICE 用同一把嗓子。
# 默认的 longjielidou_v3.6（龙杰力豆，5 岁男童）官方音色表写明「中文（普通话）、英文」，
# 中英都能念，所以英文模式默认不换音色 —— 两种语言同一个方方，音质与人格一致。
# 想要纯美音可填 loongeva_v3.6（女）或 loongjohn（男），但都是成人嗓，不适合本站。
# 2026-07-27 复核官方音色表 https://help.aliyun.com/zh/model-studio/qwen-audio-tts-voice-list
# ：以上三把均无「即将下线」标。换之前自己再去看一眼，别照抄这一行。
TTS_VOICE_EN=
ASR_MODEL=fun-asr-flash-2026-06-15
JUDGE_MODEL=qwen3.5-omni-flash
# 视觉理解：孩子把做好的纸盒举给摄像头，模型看着照片说一句夸奖（/api/vision）。
# 选 flash 是因为这活儿只要「看出颜色和形状、说一句人话」，不值旗舰的钱和延迟。
# 2026-07 查百炼下线公告：qwen3-vl-flash / qwen3-vl-plus 等一整批 VL 模型
# 2026-10-10 下线，官方给的迁移目标就是 qwen3.6-flash（旗舰是 qwen3.7-plus）。
# 换型号前先自己去模型市场看一眼「即将下线」标，别照抄这一行。
VISION_MODEL=qwen3.6-flash
PORT=8300

# 静态资源缓存分流：dev（缺省）= 本机开发，一切静态响应 no-cache，改完刷新就见新；
# public = 公网上让浏览器直接用缓存秒开、后台静静校验（stale-while-revalidate）。
# ECS 上填 public；本机开发不用动（留空即 dev）。
CACHE_PROFILE=dev

# ---- 账号体系（.scratch/accounts/ spec）----
# AUTH_MODE：off（缺省）= 本机开发/离线，零鉴权、不连库、不碰阿里云，一切照旧；
# on = 整站上锁（未登录页面 302 到 /登录、API 返 401），下面的凭据全部必填，
#      缺任一项进程启动即报错（不放残站上线）。ECS 上填 on；本机开发留空即 off。
AUTH_MODE=off
# 远程 Postgres 连接串。密码含特殊字符要按 URL 编码（@ → %40）。
DATABASE_URL=postgresql+psycopg://用户:密码@主机:5432/math_edu
# 会话签名密钥。生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# 阿里云图形验证码（验证码 2.0，控制台 → 验证码）
ALIYUN_CAPTCHA_APP_ID=
ALIYUN_CAPTCHA_APP_KEY=
# 阿里云短信（Dypnsapi，RAM 子账号 AK/SK + 签名 + 验证码模板 code）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
